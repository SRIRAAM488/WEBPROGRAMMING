# DailyFlow frontend environment variables
# Copy this file to `.env` and adjust the values if needed.
# Vite only exposes variables prefixed with VITE_ to the browser.

# Base URL of the FastAPI backend.
# The standard backend port is 8000.
# IMPORTANT: if another program is already using port 8000 on your machine,
# start the backend on a free port and put THAT value here, for example:
#   uvicorn app.main:app --port 8010
#   VITE_API_BASE_URL=http://127.0.0.1:8010
VITE_API_BASE_URL=http://127.0.0.1:8000