# DailyFlow backend - example environment file.
#
# Copy this file to `.env` and edit if you need different values.
# Every variable is optional: the app runs with the defaults shown
# below if no .env exists at all.

# SQLite database file. Created automatically on first run.
DATABASE_URL=sqlite:///./dailyflow.db

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175

# When true, any http://localhost:<port> origin is accepted. Handy while
# developing because Vite may pick a different port each time.
# Set to false for anything beyond a local demo.
CORS_ALLOW_ANY_LOCALHOST=true

# Create tables and demo data when the API boots.
# Set to false once you want an empty database.
SEED_ON_STARTUP=true
